# CargoPulse configuration
# Docker:  cp .env.example .env            (compose reads it automatically)
# Local:   cp .env.example backend/.env    (the backend reads backend/.env)
# Inside Docker Compose the database/redis hosts are overridden to the service names.

# --- PostgreSQL ---
POSTGRES_USER=cargopulse
POSTGRES_PASSWORD=cargopulse
POSTGRES_DB=cargopulse
DATABASE_URL=postgresql+psycopg://cargopulse:cargopulse@localhost:5432/cargopulse
# Separate database used by pytest (it is migrated and truncated by the test-suite)
TEST_DATABASE_URL=postgresql+psycopg://cargopulse:cargopulse@localhost:5432/cargopulse_test

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- API ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Load demo data on first start when the database is empty (Docker only)
SEED_DEMO_DATA=true

# --- Overdue detection ---
# How often Celery beat runs the overdue scan
OVERDUE_SCAN_INTERVAL_SECONDS=300
# Minutes past ETA before a shipment counts as overdue
OVERDUE_GRACE_MINUTES=0
# Redis lock expiry that prevents overlapping scans
OVERDUE_LOCK_TIMEOUT_SECONDS=120

# --- Frontend ---
# Where the Vite dev server proxies /api requests
VITE_API_PROXY_TARGET=http://localhost:8000
# Set to true when file changes are not picked up inside Docker (macOS/Windows)
VITE_USE_POLLING=false

# --- Host ports (Docker) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173
